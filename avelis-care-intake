<script>
  let currentSection = 0;
  const totalSections = 6;

  function updateProgress(idx) {
    document.querySelectorAll('.progress-step').forEach((step, i) => {
      step.classList.remove('active', 'done');
      if (i === idx) step.classList.add('active');
      else if (i < idx) step.classList.add('done');
      // Update dot text for done steps
      step.querySelector('.step-dot').textContent = i < idx ? '✓' : (i + 1);
    });
  }

  function showSection(idx) {
    document.querySelectorAll('.form-section').forEach(s => s.classList.remove('active'));
    document.getElementById('section-' + idx).classList.add('active');
    updateProgress(idx);
    window.scrollTo({ top: 0, behavior: 'smooth' });
    currentSection = idx;
  }

  function validateSection(idx) {
    let valid = true;
    if (idx === 0) {
      ['contactFirst','contactLast','contactPhone','contactEmail','relationship','location'].forEach(id => {
        const el = document.getElementById(id);
        const group = el?.closest('.field-group');
        if (!el?.value.trim()) {
          group?.classList.add('has-error');
          valid = false;
        } else {
          group?.classList.remove('has-error');
        }
      });
      // Email format
      const email = document.getElementById('contactEmail');
      if (email && email.value && !email.value.includes('@')) {
        email.closest('.field-group')?.classList.add('has-error');
        valid = false;
      }
    }
    if (idx === 1) {
      const name = document.getElementById('clientFirst');
      const group = name?.closest('.field-group');
      if (!name?.value.trim()) { group?.classList.add('has-error'); valid = false; }
      else group?.classList.remove('has-error');
    }
    if (idx === 5) {
      // At least one service selected
      const checked = document.querySelectorAll('#servicesCheck input:checked');
      const errEl = document.getElementById('servicesError');
      if (checked.length === 0) {
        errEl.style.display = 'block';
        valid = false;
      } else {
        errEl.style.display = 'none';
      }
      // Urgency
      const urgency = document.getElementById('urgency');
      const uGroup = urgency?.closest('.field-group');
      if (!urgency?.value) { uGroup?.classList.add('has-error'); valid = false; }
      else uGroup?.classList.remove('has-error');
    }
    return valid;
  }

  function nextSection(current) {
    if (!validateSection(current)) return;
    if (current < totalSections - 1) showSection(current + 1);
  }

  function prevSection(current) {
    if (current > 0) showSection(current - 1);
  }

  const INTAKE_ENDPOINT = "https://script.google.com/macros/s/AKfycbyeLw-CHl0qQO_7v1gdEqm_eTdRWmzq5fDqlbGmGP6KcsqCW1k6F-wkIWLGdnE8ZTFA/exec";

  function submitForm() {
    if (!validateSection(5)) return;

    const btn = document.querySelector('.btn-submit');
    btn.textContent = 'Submitting…';
    btn.disabled = true;
    btn.style.opacity = '0.7';

    // Collect all checked checkboxes by section
    const getChecked = (name) => [...document.querySelectorAll(`input[name="${name}"]:checked`)].map(el => el.value).join(', ');
    const getCheckedByGroup = (groupSelector) => [...document.querySelectorAll(`${groupSelector} input[type="checkbox"]:checked`)].map(el => el.closest('.check-item')?.textContent.trim()).join(', ');
    const getRadioVal = (name) => document.querySelector(`input[name="${name}"]:checked`)?.value || '';
    const getRadioText = (name) => document.querySelector(`input[name="${name}"]:checked`)?.closest('.check-item')?.textContent.trim() || '';
    const val = (id) => document.getElementById(id)?.value?.trim() || '';

    const payload = {
      // Section 1 — Contact
      contactName:    val('contactFirst') + ' ' + val('contactLast'),
      phone:          val('contactPhone'),
      email:          val('contactEmail'),
      relationship:   val('relationship'),
      location:       val('location'),

      // Section 2 — Person in care
      clientName:     val('clientFirst'),
      diagnosis:      getCheckedByGroup('#diagnosisCheck'),
      stage:          getRadioText('stage'),

      // Section 5 — Burnout
      burnout:        getRadioVal('burnout'),

      // Section 6 — Services & logistics
      services:       getCheckedByGroup('#servicesCheck'),
      urgency:        val('urgency'),

      // Full textarea notes — grab all paragraph answers
      notes: [...document.querySelectorAll('textarea')]
               .map(t => t.value.trim())
               .filter(Boolean)
               .join('\n\n---\n\n'),
    };

    fetch(INTAKE_ENDPOINT, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(() => showSuccess())
    .catch(() => showSuccess()); // no-cors won't return readable response — treat completion as success

    function showSuccess() {
      document.getElementById('formView').style.display = 'none';
      document.getElementById('successView').classList.add('show');
      document.querySelectorAll('.progress-step').forEach(step => {
        step.classList.remove('active', 'done');
        step.classList.add('done');
        step.querySelector('.step-dot').textContent = '✓';
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // Clear error on input
  document.querySelectorAll('input, select, textarea').forEach(el => {
    el.addEventListener('input', () => el.closest('.field-group')?.classList.remove('has-error'));
    el.addEventListener('change', () => el.closest('.field-group')?.classList.remove('has-error'));
  });
</script>
